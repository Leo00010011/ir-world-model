# Python / uv
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# Local secrets / env
.env

# Run artefacts (normally under $IRWM_OUTPUT_ROOT, but guard against local spills).
# Anchored with a leading "/" on purpose: an unanchored `wandb/` also ignored the
# Hydra config group lib/irwm/conf/wandb/.
/outputs/
/multirun/
/wandb/
/lightning_logs/
/slurm_logs/
slurm-*.out

# Large binaries (weights, caches) never go in git
*.ckpt
*.h5
*.hdf5
*.pth
*.pt
*.safetensors

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.json
# committed clip sets (F3): small reference indices, not data
!lib/irwm/data/clip_sets/*.json
/feature_extraction/
outputs/*