# Copy to .env (git-ignored) and adjust. Only these variables may hold paths (TechStack §6).
# Variables already set in the shell / by SLURM take precedence over this file.
# raw datasets (read-only), expects teledyne_flir_adas_v2/ inside
IRWM_DATA_ROOT=~/irwm/data
# feature + prediction caches
IRWM_CACHE_ROOT=~/irwm/cache
# our checkpoints + downloaded DINOv2 / DINO-Foresight weights
IRWM_CKPT_ROOT=~/irwm/checkpoints
# Hydra run dirs, eval JSONs, figures
IRWM_OUTPUT_ROOT=~/irwm/outputs

WANDB_PROJECT=ir-world-model
# WANDB_ENTITY=your-entity
# default; slurm/env.sh exports WANDB_API_KEY from it if unset
# WANDB_API_KEY_FILE=~/.wandb_api_key
# use on compute nodes without internet; sync later with `wandb sync`
# WANDB_MODE=offline
